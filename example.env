# ====================================================
# Silver Fund Web API - Environment Variables
# ====================================================
# Copy this file to `.env` for local development.

# --- PostgreSQL RDS Database ---
# RDS PostgreSQL endpoint hostname (e.g. localhost for local proxy or RDS endpoint)
DB_ENDPOINT=localhost
DB_PORT=5432
DB_NAME=silverfund
DB_USER=postgres
DB_PASSWORD=your_db_password

# --- AWS Cognito Authentication ---
# AWS region for Cognito user pool and S3
COGNITO_REGION=us-west-2
# Cognito User Pool ID used for JWT token validation
COGNITO_USER_POOL_ID=us-west-2_xxxxxxxxx
# App client ID for API authentication
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AWS S3 Data Access ---
# IAM credentials with read access to S3 Barra data buckets (barra-stock-history, barra-covariance-matrices, etc.)
COGNITO_ACCESS_KEY_ID=your_aws_access_key_id
COGNITO_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- CORS Settings ---
# Comma-separated allowed frontend origins
CORS_ACCESS_LIST_CSV=http://localhost:3000,https://silverfund.byu.edu
