# ====================================================
# Silver Fund Web API - Environment Variables
# ====================================================
# Copy this file to `.env` for local development.

# --- PostgreSQL RDS Database ---
# RDS PostgreSQL endpoint hostname (e.g. localhost for local proxy or RDS endpoint)
DB_ENDPOINT=localhost
DB_PORT=5432
DB_NAME=silverfund
DB_USER=postgres
DB_PASSWORD=your_db_password

# --- AWS Cognito Authentication ---
# AWS region for Cognito user pool and S3
COGNITO_REGION=us-west-2
# Cognito User Pool ID used for JWT token validation
COGNITO_USER_POOL_ID=us-west-2_xxxxxxxxx
# App client ID for API authentication
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Chatbot Bedrock models ---
BEDROCK_CHAT_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- AWS S3 Data Access ---
# IAM credentials with read access to S3 Barra data buckets (barra-stock-history, barra-covariance-matrices, etc.)
COGNITO_ACCESS_KEY_ID=your_aws_access_key_id
COGNITO_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- CORS Settings ---
# Comma-separated allowed frontend origins
CORS_ACCESS_LIST_CSV=http://localhost:3000,https://silverfund.byu.edu

# --- Production hardening ---
# Set APP_ENVIRONMENT=prod only in Elastic Beanstalk. In that mode API docs are
# disabled and every route except /health requires a Host listed below.
APP_ENVIRONMENT=development
TRUSTED_HOSTS_CSV=

# --- API abuse controls ---
# Per-instance limits for expensive routes. Configure an AWS WAF/ALB rate rule
# as the shared edge limit for all Elastic Beanstalk instances.
MAX_REQUEST_BODY_BYTES=65536
CHAT_REQUESTS_PER_MINUTE=12
CHAT_MAX_CONCURRENT_REQUESTS=4
EXPORT_REQUESTS_PER_MINUTE=30
EXPORT_MAX_CONCURRENT_REQUESTS=2
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=30000
BEDROCK_MAX_OUTPUT_TOKENS=1200
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=75
